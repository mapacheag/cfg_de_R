plotly::style(
# Tooltip para línea de mujeres
text = ~text_mujeres,
hoverinfo = "text",
traces = 1
) |>
plotly::style(
# Tooltip para línea de hombres
text = ~text_hombres,
hoverinfo = "text",
traces = 2
) |>
plotly::layout(
font = list(family = "Arial, sans-serif"),
paper_bgcolor = "rgba(0,0,0,0)",
plot_bgcolor = "rgba(0,0,0,0)",
hoverlabel = list(
bgcolor = "white",
font = list(size = 12),
bordercolor = "lightgray"
)
)
# Mostrar gráfico interactivo
print(plotly_p3)
######################## FIN DE PLANTILLA SERIE DE TIEMPO #########################
###################################################################################
warnings()
#si no existe el paquete plotly, lo instalamos
if(!require(plotly)){install.packages("plotly")}
# Datos tipo "tibble" (generados de forma reproducible)
set.seed(123)
#Formatea el rango de fechas desde el 2012 hasta el 2022, en rangos de 1 año
fechas_comparativo <- seq(as.Date("2012-01-01"), as.Date("2022-01-01"), by = "1 year")
n_comparativo <- length(fechas_comparativo)
#Series de datos
serie_verde_comparativo <- df_fem_i$TASA
serie_azul_comparativo  <- df_masc_i$TASA
#Une los datos a graficar
datos_comparativo <- tibble::tibble(
año = fechas_comparativo,
verde = serie_verde_comparativo,
azul  = serie_azul_comparativo
) |>
dplyr::mutate(
año_anio = format(año, "%b %Y"),
# Crear columnas de tooltip
text_mujeres = paste0("Año: ", format(año, "%Y"), "<br>",
"Grupo: Mujeres<br>",
"Tasa: ", round(verde, 2)),
text_hombres = paste0("Año: ", format(año, "%Y"), "<br>",
"Grupo: Hombres<br>",
"Tasa: ", round(azul, 2))
) |>
dplyr::select(año, año_anio, verde, azul, text_mujeres, text_hombres)
# Gráfico ggplot básico - NO hay parámetro 'text' aquí
p3 <- ggplot2::ggplot(datos_comparativo, ggplot2::aes(x = año)) +
# Línea para mujeres
geom_line(
ggplot2::aes(y = verde, color = "Mujeres"),
size = 1
) +
# Línea para hombres
geom_line(
ggplot2::aes(y = azul, color = "Hombres"),
size = 1
) +
scale_color_manual(
name = "Leyenda",
values = c("Mujeres" = "#01c9ad", "Hombres" = "#9682fc")
) +
scale_x_date(date_labels = "%Y", date_breaks = "1 year") +
labs(y = "Suicidios por cada 100.000 habitantes", x = "Año") +
theme_minimal()
# Mostrar gráfico estático
print(p3)
# Convertir a plotly - Asegurar que plotly_p3 use datos_comparativo
plotly_p3 <- plotly::ggplotly(p3) |>
plotly::style(
# Tooltip para línea de mujeres (trace 1)
text = datos_comparativo$text_mujeres,
hoverinfo = "text",
traces = 1
) |>
plotly::style(
# Tooltip para línea de hombres (trace 2)
text = datos_comparativo$text_hombres,
hoverinfo = "text",
traces = 2
) |>
plotly::layout(
font = list(family = "Arial, sans-serif"),
paper_bgcolor = "rgba(0,0,0,0)",
plot_bgcolor = "rgba(0,0,0,0)",
hoverlabel = list(
bgcolor = "white",
font = list(size = 12),
bordercolor = "lightgray"
),
hovermode = "x"  # Esto ayuda a mostrar tooltips
)
# Mostrar gráfico interactivo
print(plotly_p3)
######################## FIN DE PLANTILLA SERIE DE TIEMPO #########################
